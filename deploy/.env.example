# =============================================================================
# ApeAdmin 生产环境变量模板
# 复制为 backend/.env 后按需修改；未列出的变量使用内置默认值
# =============================================================================

# ---- 应用 ----
APP_NAME=ApeAdmin
APP_VERSION=0.1.0
# 生产必须为 False
DEBUG=False

# ---- 数据库 ----
# MySQL（本部署方案默认，宝塔面板可一键建库）:
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=apeadmin
DB_PASSWORD=改成强密码
DB_NAME=apeadmin
# SQLite（备选，开箱即用，不配 MySQL 时使用）:
# DB_TYPE=sqlite
# DB_NAME=apeadmin

# ---- 安全（必改） ----
# 生成方式: openssl rand -hex 32
# 注意: 该密钥同时用于 JWT 签名与数据库内 API Key 加密（Fernet 派生），
#       一旦首次启动后请勿再变更，否则已保存的 DeepSeek/千问 Key 将无法解密
#       （若从开发库迁移数据过来，迁移时需做密钥轮换，见 DEPLOY.md 迁移章节）
JWT_SECRET=请用 openssl-rand-hex-32-生成的64位随机串替换
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# 超级管理员（仅首次初始化种子数据时生效）
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=改成强密码

# ---- 跨域 ----
# 改成你的实际域名（协议+域名，不带末尾斜杠）
CORS_ORIGINS=["https://your-domain.com"]

# ---- 功能开关 ----
MCP_ENABLED=True
PLUGINS_ENABLED=True
